@PACKAGE_INIT@

if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
    "mesdk is built for 32-bit Windows. Configure with ${CMAKE_CURRENT_LIST_DIR}/toolchains/mingw-i686.cmake "
    "(Linux) or cmake -A Win32 (Visual Studio).")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mesdkTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/mesdk-functions.cmake")

check_required_components(mesdk)
